# ==============================================================================
# CleanDesk Messaging Pipeline Environment Configuration
# ==============================================================================

# Server Configuration
PROJECT_NAME="CleanDesk Event-Driven Messaging Pipeline"
API_V1_STR="/api"
HOST="0.0.0.0"
PORT=8000
DEBUG=True

# MongoDB Connection
# Set your MongoDB Atlas or local MongoDB connection URI here
# Example: mongodb+srv://username:password@cluster.mongodb.net/cleandesk?retryWrites=true&w=majority
MONGODB_URI=""
MONGODB_DB_NAME="cleandesk_pipeline"

# Redis Queue Connection
# For Upstash Redis, you can provide either:
# 1) REDIS_URL="https://your-db.upstash.io" and REDIS_TOKEN="your_token"
# 2) Full TLS URI: REDIS_URL="rediss://default:your_token@your-db.upstash.io:6379"
# Default local Redis URL: redis://localhost:6379/0
REDIS_URL="redis://localhost:6379/0"
REDIS_TOKEN=""
REDIS_QUEUE_NAME="cleandesk:interactions:queue"

# Gemini AI / LLM Configuration
# Paste your Google Gemini API key to enable live RAG response generation
# If not provided, an intelligent brand-aware heuristic RAG engine is used.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Rate Limiting & Account Protection Safeguards
MAX_DAILY_QUOTA_DEFAULT=50
RISK_THRESHOLD_REJECTION=80
INTER_MESSAGE_PACING_MS=750
