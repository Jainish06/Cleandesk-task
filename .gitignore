# ==============================================================================
# Master .gitignore for CleanDesk Task
# ==============================================================================

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor
.vscode/
.idea/
*.swp
*.swo

# Environment Variables & Secrets (NEVER push credentials to GitHub!)
.env
.env.*
!.env.example
backend/.env
frontend/.env.local
frontend/.env.*.local

# Python / Backend
backend/.venv/
backend/venv/
backend/__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.tox/
dist/
build/
*.egg-info/

# Node / Frontend
frontend/node_modules/
node_modules/
frontend/.next/
frontend/out/
frontend/build/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
frontend/.vercel
